                     /translation="MLGPYEKKWLCITRTVTYVGWSLFWLLLWDVAVTVDVMLVEGAGI
                     DFPLMPLTLLCSALIVLISFRNSSAYNRWWEARTLWGSMVNSSRSFGRQVLTLIDAERE
